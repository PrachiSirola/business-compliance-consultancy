# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS
# (public frontend + admin-frontend, dev ports shown)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:4174

# MongoDB Atlas connection string
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/suits?retryWrites=true&w=majority
MONGODB_URI=

# JWT auth (admin dashboard login)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Suits Assistant chatbot (see src/controllers/chatController.js)
# Get a key from the Anthropic Console: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Admin seed script (npm run seed:admin) ---
# Run once (or whenever you want to reset the password) to create the
# admin account used to log into admin-frontend. Not read anywhere else.
ADMIN_NAME=Deepika
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
